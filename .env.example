# COMP-05 / D-01 — NUNCA dentro do OneDrive nem do repo. O boot aborta com
# DATA_ROOT_ON_ONEDRIVE se este caminho tiver atributo ReparsePoint.
DATA_ROOT=C:\whatsapp_prospecao
# D-04 / R-023 — defaults configuraveis, nunca hardcoded no gate (D-05).
# O teto fisico de 30 e o CHECK do banco (daily_counters); o 25 e operacional.
DAILY_MESSAGE_LIMIT=25
# D-04 / R-023 — contatos novos por dia util.
DAILY_LEAD_LIMIT=20
# R-006 / AR-007 — janela operacional, dias uteis, intervalo [start, end).
WINDOW_START_HOUR=7
WINDOW_END_HOUR=17
# WHS-05 — o numero dedicado em E.164. CHECK no banco: ^\+[1-9][0-9]{7,14}$
CHANNEL_PHONE_E164=+5511999999999
# R-042 — kill switch. true aborta tudo antes de qualquer verificacao.
KILL_SWITCH=false
# R-031 — PostgreSQL 18.3 local. A senha nao vai para nenhum arquivo versionado.
DATABASE_URL=postgres://USUARIO:SENHA@127.0.0.1:5432/whatsapp_prospect
# D-05 / A7 — o gate avalia a janela no fuso de Sao Paulo, nao no fuso do processo.
TZ=America/Sao_Paulo
